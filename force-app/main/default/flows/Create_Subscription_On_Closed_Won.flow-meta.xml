    <description
  >Creates a Subscription when an Opportunity reaches Closed Won, then links it back to the Opportunity. Users holding Bypass_Subscription_Flow are skipped. Failures raise an Error_Log__c record and a Sales Ops task.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxEndDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CloseDate} + ({!fxTermMonths} * 30)</expression>
    </formulas>
    <formulas>
        <name>fxFailureTaskDescription</name>
        <dataType>String</dataType>
        <expression
    >&quot;Flow: Create_Subscription_On_Closed_Won&quot; &amp; BR() &amp;
&quot;Opportunity Id: &quot; &amp; {!$Record.Id} &amp; BR() &amp;
&quot;Error: &quot; &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>fxFailureTaskSubject</name>
        <dataType>String</dataType>
        <expression
    >&quot;Subscription auto-creation failed for Opp: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>fxMrr</name>
        <dataType>Currency</dataType>
        <expression>IF(
  OR(ISBLANK({!$Record.Amount}), {!fxTermMonths} &lt;= 0),
  0,
  {!$Record.Amount} / {!fxTermMonths}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxRenewalType</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISBLANK(TEXT({!$Record.Renewal_Type__c}))),
  TEXT({!$Record.Renewal_Type__c}),
  &quot;New Business&quot;
)</expression>
    </formulas>
    <formulas>
        <name>fxTermMonths</name>
        <dataType>Number</dataType>
        <expression>IF(
  OR(ISBLANK({!$Record.Term_Months__c}), {!$Record.Term_Months__c} &lt;= 0),
  12,
  {!$Record.Term_Months__c}
)</expression>
        <scale>0</scale>
    </formulas>
