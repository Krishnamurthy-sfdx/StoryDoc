<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Check_Already_Reminded_Today</name>
        <label>Check Already Reminded Today</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>Not Reminded Today</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Evaluate_Expiry_Threshold</targetReference>
        </defaultConnector>
        <rules>
            <name>Already_Reminded_Today</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Last_Reminder_Sent_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <label>Already Reminded Today</label>
        </rules>
    </decisions>
    <decisions>
        <name>Evaluate_Expiry_Threshold</name>
        <label>Evaluate Expiry Threshold</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>No Threshold Reached</defaultConnectorLabel>
        <rules>
            <name>Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.End_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Expired</targetReference>
            </connector>
            <label>Expired</label>
        </rules>
        <rules>
            <name>Within_7_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Days_Until_Expiry__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>7.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Urgent_Renewal_Task</targetReference>
            </connector>
            <label>Within 7 Days</label>
        </rules>
        <rules>
            <name>Within_30_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Days_Until_Expiry__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_High_Renewal_Task</targetReference>
            </connector>
            <label>Within 30 Days</label>
        </rules>
        <rules>
            <name>Within_60_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference
        >$Record.Days_Until_Expiry__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>60.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Normal_Renewal_Task</targetReference>
            </connector>
            <label>Within 60 Days</label>
        </rules>
    </decisions>
    <description
  >Runs daily at 06:00 org time over Active and Expiring Soon subscriptions. Raises renewal tasks at the 60, 30 and 7 day thresholds, flips the record to Expiring Soon at 60 days and to Expired on or after the end date. Records already reminded today are skipped.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxRenewalTaskSubject</name>
        <dataType>String</dataType>
        <expression
    >&quot;Subscription Renewal: &quot; &amp; {!$Record.Account__r.Name} &amp; &quot; &#8211; &quot; &amp; {!$Record.Name} &amp; &quot; expires in &quot; &amp; TEXT(FLOOR({!$Record.Days_Until_Expiry__c})) &amp; &quot; days&quot;</expression>
    </formulas>
    <interviewLabel
  >Daily Subscription Expiry Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Daily Subscription Expiry Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
