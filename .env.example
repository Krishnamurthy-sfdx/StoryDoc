# StoryDoc local configuration template
# Copy this file to .env, then run: chmod 600 .env
# Never commit .env or paste actual token values into documentation, issues, or chat.

# Jira site and the two custom fields StoryDoc is allowed to request.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_12345
JIRA_TECHNICAL_DESIGN_FIELD=customfield_12346

# Scoped Atlassian API-token authentication (recommended).
# Find the cloud ID from: https://your-company.atlassian.net/_edge/tenant_info
JIRA_CLOUD_ID=your-atlassian-cloud-id
JIRA_EMAIL=developer@example.com
JIRA_API_TOKEN=

# Optional alternative for an organisation-managed integration. Leave blank when
# using JIRA_EMAIL and JIRA_API_TOKEN. Do not configure both authentication modes.
# JIRA_BEARER_TOKEN=

# Optional model overrides. Defaults are Terra low and Luna high.
# STORYDOC_REQUIREMENTS_MODEL=gpt-5.6-terra
# STORYDOC_REQUIREMENTS_REASONING_EFFORT=low
# STORYDOC_IMPLEMENTATION_MODEL=gpt-5.6-luna
# STORYDOC_IMPLEMENTATION_REASONING_EFFORT=high
